# 停用範本。這不是 GitHub Actions 工作流。
# 必須留在 docs/claude-code/templates/claude.yml.example。
# GitHub 只執行 .github/workflows/*.yml 與 *.yaml。
# 審核期間不要搬移本檔、不要移除下方停用條件、不要取消註解認證。
# 啟用需另一次核准。步驟見 docs/claude-code/REVIEW.md。

name: Claude Code

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]
  pull_request_review:
    types: [submitted]
  issues:
    types: [opened]

jobs:
  claude:
    # REVIEW GUARD: keep this false until a separate approved enablement change.
    if: ${{ false }}
    runs-on: ubuntu-latest
    timeout-minutes: 8
    concurrency:
      group: claude-code-bonus-split-${{ github.event.issue.number || github.event.pull_request.number || github.ref }}
      cancel-in-progress: true
    permissions:
      contents: write
      pull-requests: write
      issues: write
      id-token: write
      actions: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          fetch-depth: 1

      - name: Run Claude Code
        uses: anthropics/claude-code-action@v1
        with:
          # Choose exactly one line later. Leave both commented for this review.
          # anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          claude_args: >-
            --max-turns 4
            --append-system-prompt "Read CLAUDE.md. Do not change bonus formulas or business behavior. Do not read or write production customer or bonus data. Use clearly labeled fictional data only. Do not deploy."
